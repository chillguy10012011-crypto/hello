local VisualSlide = createSlide("Visual")
local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local EspToggle = false

local EspBtn = Instance.new("TextButton")
EspBtn.Size = UDim2.new(0.95, 0, 0, 30)
EspBtn.Position = UDim2.new(0.025, 0, 0, 20)
EspBtn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
EspBtn.BorderColor3 = Color3.fromRGB(0, 170, 255)
EspBtn.Text = "ESP Highlight: OFF"
EspBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
EspBtn.Parent = VisualSlide

EspBtn.MouseButton1Click:Connect(function()
    EspToggle = not EspToggle
    EspBtn.Text = "ESP Highlight: " .. (EspToggle and "ON" or "OFF")
    
    for _, p in pairs(Players:GetPlayers()) do
        if p.Character then
            local highlight = p.Character:FindFirstChild("CustomESPHighlight")
            if EspToggle then
                if not highlight then
                    highlight = Instance.new("Highlight")
                    highlight.Name = "CustomESPHighlight"
                    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
                    highlight.Parent = p.Character
                end
                highlight.FillColor = (p == LocalPlayer) and Color3.fromRGB(0, 170, 255) or Color3.fromRGB(255, 0, 0)
            else
                if highlight then highlight:Destroy() end
            end
        end
    end
end)

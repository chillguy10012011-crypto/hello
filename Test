addParameterButton(AimlockFrame, "Thông số • Aimlock", {
    {name="Bán kính FOV", min=20, max=400, get=function() return aimlockFovSize end, set=function(v) aimlockFovSize = v end},
    {name="Thời gian khóa (s)", min=0.1, max=3, get=function() return aimlockLockTime end, set=function(v) aimlockLockTime = v end},
    {name="Hitbone (1:Đầu, 2:Thân)", min=1, max=2, get=function() return aimlockHitbone == "Head" and 1 or 2 end, set=function(v) aimlockHitbone = math.floor(v+0.5) == 1 and "Head" or "HumanoidRootPart" end},
    {name="Tự động bắn (0:Tắt, 1:Bật)", min=0, max=1, get=function() return aimlockAutoShoot and 1 or 0 end, set=function(v) aimlockAutoShoot = math.floor(v+0.5) == 1 end},
})

local function isTargetVisible(targetPart)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp or not targetPart then return false end

    local raycastParams = RaycastParams.new()
    raycastParams.FilterType = Enum.RaycastFilterType.Exclude
    raycastParams.FilterDescendantsInstances = {character, targetPart.Parent}
    raycastParams.IgnoreWater = true

    local direction = targetPart.Position - hrp.Position
    local result = Workspace:Raycast(hrp.Position, direction, raycastParams)

    return result == nil
end

local function getBestTarget()
    local camera = Workspace.CurrentCamera
    local viewportCenter = camera.ViewportSize / 2
    local closestTarget = nil
    local shortestDist = aimlockFovSize

    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Team ~= LocalPlayer.Team then
            local char = p.Character
            local humanoid = char and char:FindFirstChildOfClass("Humanoid")
            local targetPart = char and char:FindFirstChild(aimlockHitbone)

            if char and humanoid and humanoid.Health > 0 and targetPart then
                if isTargetVisible(targetPart) then
                    local screenPos, onScreen = camera:WorldToViewportPoint(targetPart.Position)
                    if onScreen then
                        local screenPos2D = Vector2.new(screenPos.X, screenPos.Y)
                        local dist = (screenPos2D - viewportCenter).Magnitude

                        if dist < shortestDist then
                            shortestDist = dist
                            closestTarget = targetPart
                        end
                    end
                end
            end
        end
    end

    return closestTarget
end

RunService.RenderStepped:Connect(function()
    if not AimlockToggle then return end

    local targetPart = getBestTarget()
    if targetPart then
        local camera = Workspace.CurrentCamera
        if camera then
            local currentCF = camera.CFrame
            local targetCF = CFrame.new(currentCF.Position, targetPart.Position)
            camera.CFrame = currentCF:Lerp(targetCF, math.clamp(RunService.RenderStepped:Wait() / aimlockLockTime, 0.05, 1))

            if aimlockAutoShoot then
                pcall(function()
                    if mouse1click then
                        mouse1click()
                    end
                end)
            end
        end
    end
end)

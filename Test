        if child:IsA("Frame") then child:Destroy() end
    end
    
    for index, pointCFrame in ipairs(savedPointsList) do
        local pointItem = Instance.new("Frame")
        pointItem.Size = UDim2.new(1, -4, 0, 28)
        pointItem.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        pointItem.BorderColor3 = Color3.fromRGB(0, 170, 255)

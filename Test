        deleteBtn.Position = UDim2.new(1, -26, 0.5, -12)
        deleteBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        deleteBtn.BorderColor3 = Color3.fromRGB(255, 0, 0)

        gotoBtn.BackgroundTransparency = 1
        gotoBtn.Text = "Điểm số " .. index
        gotoBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        gotoBtn.Font = Enum.Font.SourceSans

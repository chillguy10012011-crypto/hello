            teleBtn.Text = "Dịch Chuyển Đến Điểm Đã Lưu"
        end

        saveBtn.MouseButton1Click:Connect(function()
            local char = LocalPlayer.Character
            local hrp = char and char:FindFirstChild("HumanoidRootPart")
            if hrp then
                savedPointMode1 = hrp.CFrame
                teleBtn.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
                teleBtn.Text = "Dịch Chuyển Đến Điểm Đã Lưu"
                saveBtn.Text = "Đã Lưu Thành Công!"
                task.delay(1, function() saveBtn.Text = "Lưu Vị Trí Hiện Tại" end)
            end
        end)

        teleBtn.MouseButton1Click:Connect(function()
            if savedPointMode1 then
                local char = LocalPlayer.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                if hrp then
                    hrp.CFrame = savedPointMode1
                end
            end
        end)
    else
        local saveBtn = createStyledButton(contentFrame, "Lưu Vị Trí Hiện Tại", UDim2.new(0, 0, 0, 5), UDim2.new(1, 0, 0, 28))
        
        local scrollList = Instance.new("ScrollingFrame")

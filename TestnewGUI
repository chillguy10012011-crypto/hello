--// Helper tạo setting
local function createSetting(name, value, y)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromOffset(200, 35)
	label.Position = UDim2.fromOffset(15, y)
	label.BackgroundTransparency = 1
	label.Text = name
	label.TextColor3 = Color3.fromRGB(220, 220, 220)
	label.TextSize = 14
	label.Font = Enum.Font.GothamMedium
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = settings

	local box = Instance.new("TextBox")
	box.Size = UDim2.fromOffset(100, 32)
	box.Position = UDim2.new(1, -115, 0, y)
	box.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
	box.Text = tostring(value)
	box.TextColor3 = Color3.fromRGB(255, 255, 255)
	box.TextSize = 14
	box.Font = Enum.Font.Gotham
	box.ClearTextOnFocus = false
	box.BorderSizePixel = 0
	box.Parent = settings

	local boxCorner = Instance.new("UICorner")
	boxCorner.CornerRadius = UDim.new(0, 6)
	boxCorner.Parent = box

	return box
end

--// Dash parameters
local distanceBox = createSetting("Distance", 25, 50)
local cooldownBox = createSetting("Cooldown", 1, 95)
local durationBox = createSetting("Duration", 0.25, 140)

--// Open / close settings
settingsButton.MouseButton1Click:Connect(function()
	settings.Visible = not settings.Visible

	if settings.Visible then
		main.Size = UDim2.fromOffset(560, 360)
	else
		main.Size = UDim2.fromOffset(560, 150)
	end
end)

--// Keybind changing
local waitingForKey = false

keyButton.MouseButton1Click:Connect(function()
	if waitingForKey then
		return
	end

	waitingForKey = true
	keyButton.Text = "..."

	local connection
	connection = UserInputService.InputBegan:Connect(function(input, processed)
		if processed then
			return
		end

		if input.UserInputType == Enum.UserInputType.Keyboard then
			keyButton.Text = input.KeyCode.Name
			connection:Disconnect()
			waitingForKey = false
		end
	end)
end)

--// Dash key test
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end

	if input.KeyCode.Name == keyButton.Text and enabled then
		print("Dash activated!")
		print("Distance:", distanceBox.Text)
		print("Cooldown:", cooldownBox.Text)
		print("Duration:", durationBox.Text)
	end
end)

getgenv().applyTheme = function(bgColor, borderColor, textColor)
    if bgColor then
        for _, obj in pairs(registeredBackgrounds) do
            if obj and (obj:IsA("Frame") or obj:IsA("ScrollingFrame")) then
                obj.BackgroundColor3 = bgColor
            end
        end
    end
    if borderColor then
        for _, obj in pairs(registeredBorders) do
            if obj then obj.BorderColor3 = borderColor end
        end
    end
    if textColor then
        for _, obj in pairs(registeredTexts) do
            if obj and (obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")) then
                obj.TextColor3 = textColor
            end
        end
    end
end

